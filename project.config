[access]
	inheritFrom = All-Projects
[access "refs/*"]
	owner = group mos-core
	owner = group user/Alexander Gubanov (greatehop)
	owner = group user/Oleksiy Butenko (obutenko)
	owner = group user/Timur Nurlygayanov (TimurNurlygayanov)
[access "refs/for/refs/*"]
	read = group mos-core
	read = group user/Timur Nurlygayanov (TimurNurlygayanov)
	push = group mos-core
	push = group user/Alexander Gubanov (greatehop)
	push = group user/Oleksiy Butenko (obutenko)
	push = group user/Timur Nurlygayanov (TimurNurlygayanov)
	label-Code-Review = -2..+2 group mos-core
	label-Code-Review = -2..+2 group user/Alexander Gubanov (greatehop)
	label-Code-Review = -2..+2 group user/Oleksiy Butenko (obutenko)
	label-Code-Review = -2..+2 group user/Timur Nurlygayanov (TimurNurlygayanov)
	label-Verified = -1..+1 group mos-core
	label-Verified = -1..+1 group user/Alexander Gubanov (greatehop)
	label-Verified = -1..+1 group user/Oleksiy Butenko (obutenko)
	label-Verified = -1..+1 group user/Timur Nurlygayanov (TimurNurlygayanov)
	rebase = group mos-core
	rebase = group user/Alexander Gubanov (greatehop)
	rebase = group user/Oleksiy Butenko (obutenko)
	rebase = group user/Timur Nurlygayanov (TimurNurlygayanov)
	removeReviewer = group mos-core
	removeReviewer = group user/Timur Nurlygayanov (TimurNurlygayanov)
	submit = group mos-core
	submit = group user/Alexander Gubanov (greatehop)
	submit = group user/Oleksiy Butenko (obutenko)
	submit = group user/Timur Nurlygayanov (TimurNurlygayanov)
[access "refs/heads/*"]
	read = group mos-core
	read = group user/Timur Nurlygayanov (TimurNurlygayanov)
	create = group mos-core
	create = group user/Timur Nurlygayanov (TimurNurlygayanov)
	push = group mos-core
	push = group user/Alexander Gubanov (greatehop)
	push = group user/Oleksiy Butenko (obutenko)
	push = +force group user/Timur Nurlygayanov (TimurNurlygayanov)
	pushMerge = group mos-core
	pushMerge = group user/Alexander Gubanov (greatehop)
	pushMerge = group user/Oleksiy Butenko (obutenko)
	pushMerge = group user/Timur Nurlygayanov (TimurNurlygayanov)
[access "refs/tags/*"]
	push = group mos-core
	push = +force group user/Timur Nurlygayanov (TimurNurlygayanov)
	pushTag = group mos-core
	pushTag = group user/Timur Nurlygayanov (TimurNurlygayanov)
	pushSignedTag = group mos-core
	pushSignedTag = group user/Timur Nurlygayanov (TimurNurlygayanov)
[receive]
	requireChangeId = true
